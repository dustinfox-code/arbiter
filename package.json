{
  "name": "arbiter-cc",
  "version": "0.2.0",
  "description": "Adversarial code review personas and a definition-of-done loop for AI coding agents \u2014 as skills, a Claude Code plugin, and a stop hook that enforces the loop in Claude Code, Codex, Copilot, Gemini and Cursor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "arbiter": "./dist/cli.js",
    "arbiter-cc": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "version": "node scripts/sync-plugin-version.mjs",
    "check:version": "node scripts/sync-plugin-version.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "templates",
    "skills",
    "hooks",
    ".claude-plugin"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "copilot",
    "cursor",
    "agent-skills",
    "skills",
    "loop",
    "critic",
    "code-review",
    "adversarial-review",
    "definition-of-done",
    "stop-hook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinfox-code/arbiter.git"
  },
  "bugs": {
    "url": "https://github.com/dustinfox-code/arbiter/issues"
  },
  "homepage": "https://github.com/dustinfox-code/arbiter#readme",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
